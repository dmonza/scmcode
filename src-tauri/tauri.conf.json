{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "scmCode",
  "version": "0.1.3",
  "identifier": "dev.scmcode.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "scmCode",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "dragDropEnabled": true,
        "useHttpsScheme": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-networking --disable-component-update --disable-domain-reliability --no-pings"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright \u00a9 2026 scmCode contributors. Based on SideX (\u00a9 Siden Technologies Inc.) and Code - OSS (\u00a9 Microsoft Corporation). MIT License.",
    "licenseFile": "../LICENSE",
    "category": "DeveloperTool",
    "shortDescription": "A minimal, privacy-focused code editor.",
    "longDescription": "scmCode is a minimal, privacy-focused code editor. It is a derivative of SideX (a Tauri port of Code - OSS) with telemetry, analytics and vendor services removed.",
    "resources": [
      "extension-host/*",
      "shell-integration/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "10.15",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  }
}
